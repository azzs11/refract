{
  "name": "refract-web",
  "private": true,
  "type": "module",
  "description": "Refract web app: the optics bench (design: the plan tab 'Web app: design and build spec').",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@playwright/test": "1.65.0",
    "@sveltejs/adapter-static": "3.0.11",
    "@sveltejs/kit": "2.70.4",
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@types/node": "24.19.2",
    "svelte": "5.33.0",
    "svelte-check": "4.2.1",
    "typescript": "5.8.3",
    "vite": "6.3.5"
  }
}
